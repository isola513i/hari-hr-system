# ============================================================================
# HARI HR System — Web (Vite) environment
# Copy to `.env.local` for local dev:  cp .env.example .env.local
# All web vars must be prefixed VITE_ to be exposed to the browser.
# ============================================================================

# API base URL.
# For LOCAL DEV you can leave this unset — the Vite dev server proxies
# /api and /uploads to http://localhost:3001 automatically.
# VITE_API_URL=http://localhost:3001/api

# For PRODUCTION, set to your deployed API URL:
VITE_API_URL=https://your-api-host.example.com/api

# ─── Optional ───────────────────────────────────────────────────────────────

# Google Analytics 4 — disabled if unset
# Google Analytics → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Sentry error tracking — disabled if unset
# https://sentry.io → project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
