# API Configuration
# For local development (uses Vite proxy, no need to set)
# VITE_API_URL=http://localhost:3001/api

# For production (set to your Render deployment URL)
VITE_API_URL=https://your-render-api.onrender.com/api

# Google Analytics 4 (optional — analytics is disabled if not set)
# Get from: Google Analytics → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
