# ============================================================================
# HARI HR System — API environment
# Copy this file to `.env` and fill in the REQUIRED values below.
#   cp .env.example .env
# ============================================================================

# ─── REQUIRED ───────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development            # development | production | test

# PostgreSQL connection string (Neon recommended, or a local Postgres)
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/dbname?sslmode=require
# Set to 'false' only for a local Postgres without SSL. Defaults to SSL on.
# DATABASE_SSL=false

# JWT signing secret — generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# PII / TOTP encryption key — MUST be exactly 64 hex chars (32 bytes).
# The API will refuse to start without it. Generate with:
#   openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ─── URLs & CORS ────────────────────────────────────────────────────────────

# Frontend origin used for CORS
FRONTEND_URL=http://localhost:5173

# Comma-separated allowed origins for Origin-validation (CSRF defense-in-depth).
# Default: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173

# Public base URL of this API (used in generated links). Default localhost:3001
# API_BASE_URL=http://localhost:3001

# ─── Admin / seed ───────────────────────────────────────────────────────────

# Initial password for the seeded admin account. Default: Welcome123!
# DEFAULT_ADMIN_PASSWORD=Welcome123!

# ─── Logging ────────────────────────────────────────────────────────────────

# Pino log level: fatal | error | warn | info | debug | trace. Default: info
LOG_LEVEL=info

# ============================================================================
# OPTIONAL — features are disabled / use defaults when these are unset
# ============================================================================

# ─── Email (AWS SES) — password reset & notification emails ─────────────────
AWS_SES_REGION=ap-southeast-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# ─── Web Push (VAPID) — browser push notifications ──────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@yourdomain.com

# ─── File storage (Cloudflare R2) — falls back to local disk if unset ───────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hari-uploads
# Public URL after enabling R2 public bucket or custom domain
# e.g. https://pub-xxxx.r2.dev  or  https://files.yourdomain.com
R2_PUBLIC_URL=
# Reported storage quota in GB (UI only). Default: 10
# STORAGE_LIMIT_GB=10

# ─── Error tracking (Sentry) — disabled if unset ───────────────────────────
# https://sentry.io → project → Settings → Client Keys (DSN)
SENTRY_DSN=

# ─── Rate limiting — defaults are production-safe; raise for local dev ──────
# RATE_LIMIT_GENERAL_MAX=500                    # per 15 min
# RATE_LIMIT_AUTH_MAX=30                        # login attempts before lockout
# RATE_LIMIT_AUTH_WINDOW_MS=300000              # auth window (5 min)
# RATE_LIMIT_FORGOT_PASSWORD_MAX=5
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=900000   # 15 min
# RATE_LIMIT_API_MAX=100                        # per 1 min
# RATE_LIMIT_BACKUP_CODE_MAX=5                  # 2FA backup-code regen
# RATE_LIMIT_BACKUP_CODE_WINDOW_MS=900000       # 15 min

# ─── Scheduled jobs (node-cron) — defaults shown ───────────────────────────
# CRON_AUTO_CHECKOUT=59 23 * * *                # auto clock-out end of day
# CRON_AUTO_ABSENT=5 0 * * *                    # mark no-shows absent
# CRON_MILESTONE=0 8 * * *                      # work-anniversary notifications
# CRON_TIMEZONE=Asia/Bangkok
