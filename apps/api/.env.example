PORT=3001
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/dbname?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Frontend URL for CORS (set to your Vercel deployment URL)
FRONTEND_URL=http://localhost:5173

# AWS SES Email
AWS_SES_REGION=ap-southeast-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Rate Limiting (requests per window — defaults are production-safe, raise for local dev)
# RATE_LIMIT_GENERAL_MAX=500          # per 15 min (default: 500)
# RATE_LIMIT_AUTH_MAX=30              # login attempts before lockout (default: 30)
# RATE_LIMIT_AUTH_WINDOW_MS=300000    # auth window in ms, default 5 min (300000)
# RATE_LIMIT_FORGOT_PASSWORD_MAX=5    # per window (default: 5)
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=900000  # default 15 min (900000)
# RATE_LIMIT_API_MAX=100              # per 1 min (default: 100)

# Web Push Notifications — VAPID keys (optional — push notifications disabled if not set)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@yourdomain.com

# Cloudflare R2 File Storage (optional — falls back to local disk if not set)
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hari-uploads
# Public URL after enabling R2 public bucket or custom domain
# e.g. https://pub-xxxx.r2.dev  or  https://files.yourdomain.com
R2_PUBLIC_URL=
